require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

# Xcode 26 / iOS 27 SDK rejects deployment targets below 15.0.
platform :ios, '15.0'
install! 'cocoapods', :deterministic_uuids => false

target 'Leva' do
  config = use_native_modules!

  # Flags change depending on the env values.
  flags = get_default_flags()
  pod 'GoogleTagManager'
  # image-crop-picker 0.38.x still uses customAspectRatio (removed in TOCrop 3.x).
  pod 'TOCropViewController', '2.8.0'
  use_react_native!(
    :path => config[:reactNativePath],
    # to enable hermes on iOS, change `false` to `true` and then install pods
    :hermes_enabled => flags[:hermes_enabled],
    :fabric_enabled => flags[:fabric_enabled],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'LevaTests' do
    inherit! :complete
    # Pods for testing
  end

  # Enables Flipper.
  #
  # Note that if you have use_frameworks! enabled, Flipper will not work and
  # you should disable the next line.
  use_flipper!()

  post_install do |installer|
    react_native_post_install(installer)
    __apply_Xcode_12_5_M1_post_install_workaround(installer)

    # Xcode 15.3+ / modern libc++: Flipper uses std::function without including <functional>.
    flipper_transport = File.join(__dir__, 'Pods/Flipper/xplat/Flipper/FlipperTransportTypes.h')
    if File.exist?(flipper_transport)
      contents = File.read(flipper_transport)
      unless contents.include?('#include <functional>')
        File.chmod(0644, flipper_transport)
        File.write(flipper_transport, contents.sub('#include <string>', "#include <functional>\n#include <string>"))
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end

        # Restore std::unary_function / binary_function removed in C++17 (Boost via RCT-Folly).
        defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
        defs = ['$(inherited)'] if defs.nil?
        defs = [defs] unless defs.is_a?(Array)
        unless defs.any? { |d| d.to_s.include?('_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION') }
          defs << '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION=1'
        end
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
      end
    end
  end
end


